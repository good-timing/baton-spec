    "ToolCallStartPayload": {
      "additionalProperties": false,
      "description": "Emitted before the vendor handler runs. ``params`` is PII-scrubbed at\nemit-time per SPEC \u00a77.\n\n``call_intent`` / ``call_expected`` / ``call_workflow`` are the values the\nSDK stripped from the injected ``user_goal`` / ``expected_result`` /\n``overall_task`` params (``integrations._llm_text``); they ride as\nSIBLINGS of ``params`` \u2014 ``params`` stays exactly the vendor-visible\narguments. ``call_intent``/``call_expected`` are call-scoped diagnostics;\n``call_workflow`` is the task-label grouping key (console rung 3b, exact\nstring continuity). ``intent_source`` records provenance\n(``\"injected_param\"``). All null when the params weren't used. The Console\nreads these off ``payload`` (``worker/correlate.py``, ``cycle.py``); kept\nin lockstep with the proxy's emitter output.",
      "properties": {
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "call_intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Intent"
        },
        "call_expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Expected"
        },
        "call_workflow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Workflow"
        },
        "intent_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intent Source"
        }
      },
      "required": [
        "tool_name"
      ],
      "title": "ToolCallStartPayload",
      "type": "object"
